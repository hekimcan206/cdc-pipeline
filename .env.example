# Copy to .env to override the development defaults used by docker-compose.yml.
# Every value here is for local demos only; never reuse them anywhere else.
SOURCE_PG_PASSWORD=source-admin-dev-only
SHOP_APP_PASSWORD=shop-app-dev-only
DBZ_PASSWORD=debezium-dev-only
READMODEL_PASSWORD=readmodel-dev-only
MEILI_MASTER_KEY=meili-master-key-dev-only-0123456789
# Oracle profile only (docker compose --profile oracle up)
ORACLE_PASSWORD=OracleDevOnly1
ORACLE_SHOP_PASSWORD=ShopDevOnly1

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Messaging and data">
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <!-- ODP.NET 23.26 pulls System.Security.Cryptography.Pkcs 8.0.1, which has a known advisory; pin the patched line. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.6.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Oracle" Version="4.16.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
</Project>
